# Godot 4+ specific ignores
.godot/
*.tmp
*.log
*.import
*.uid

# Import cache (auto-regenerated by Godot on open)
.import/

# Mono/.NET
.mono/
data_*/
mono_crash.*.json

# OS generated
.DS_Store
Thumbs.db
Desktop.ini

# Build exports
export/
build/
*.exe
*.x86_64
*.apk
*.aab
*.pck

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Local planning / source dumps not needed in repo
cyberprantk/
nature-assets/
road-asset/
rock-assets/
ui-assets/
new_plan.md
tmp_nature_*.png

# Keep only the runtime font subset used by the game UI
fonts/*
!fonts/Atkinson_Hyperlegible/
fonts/Atkinson_Hyperlegible/*
!fonts/Atkinson_Hyperlegible/AtkinsonHyperlegible-Regular.ttf
!fonts/Atkinson_Hyperlegible/AtkinsonHyperlegible-Bold.ttf
!fonts/Atkinson_Hyperlegible/OFL.txt
!fonts/Fredoka/
fonts/Fredoka/*
!fonts/Fredoka/static/
!fonts/Fredoka/OFL.txt
fonts/Fredoka/static/*
!fonts/Fredoka/static/Fredoka-Bold.ttf
!fonts/Fredoka/static/Fredoka-SemiBold.ttf
